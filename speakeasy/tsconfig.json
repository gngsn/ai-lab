{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "tests",
    "public/js",
    "playwright.config.ts",
    "vitest.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "tests/fixtures"]
}
