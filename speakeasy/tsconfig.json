{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "paths": {
      "/vendor/modules/supabase-client.mjs": ["./src/runtime/supabase-client.d.ts"],
      "/js/deck-host.js": ["./src/runtime/deck-host.ts"],
      "/js/sync.js": ["./src/runtime/sync.ts"],
      "/js/captions/audience.js": ["./src/runtime/captions-audience.ts"]
    }
  },
  "include": [
    "src",
    "vite-plugins",
    "tests",
    "playwright.config.ts",
    "vitest.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "tests/fixtures"]
}
