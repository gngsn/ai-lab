{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/build-config.mjs && vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/config.local.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/edit",
      "destination": "/"
    },
    {
      "source": "/edit.html",
      "destination": "/"
    },
    {
      "source": "/notes",
      "destination": "/"
    },
    {
      "source": "/notes.html",
      "destination": "/"
    },
    {
      "source": "/script",
      "destination": "/"
    },
    {
      "source": "/script.html",
      "destination": "/"
    },
    {
      "source": "/script-edit",
      "destination": "/"
    },
    {
      "source": "/script-edit.html",
      "destination": "/"
    },
    {
      "source": "/pronunciation",
      "destination": "/"
    },
    {
      "source": "/pronunciation.html",
      "destination": "/"
    },
    {
      "source": "/captions",
      "destination": "/"
    },
    {
      "source": "/captions.html",
      "destination": "/"
    },
    {
      "source": "/view",
      "destination": "/"
    },
    {
      "source": "/view.html",
      "destination": "/"
    },
    {
      "source": "/share",
      "destination": "/"
    },
    {
      "source": "/share.html",
      "destination": "/"
    },
    {
      "source": "/present",
      "destination": "/"
    },
    {
      "source": "/present.html",
      "destination": "/"
    },
    {
      "source": "/edit-frame",
      "destination": "/"
    },
    {
      "source": "/edit-frame.html",
      "destination": "/"
    }
  ]
}
