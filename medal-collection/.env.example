# Optional. Without these, medals and profile are stored in this browser (IndexedDB).
# Run supabase/schema.sql in your project's SQL editor before enabling sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional AI cleanup, used only on the server. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set a long random value and schedule /api/maintenance daily with Bearer authorization.
CRON_SECRET=
